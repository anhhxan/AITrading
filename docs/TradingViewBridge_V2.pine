//@version=5
indicator("DUMB PINE - State Reporter V2", overlay=true)

length = input.int(20, title="BB Length")
mult = input.float(2.5, title="BB Mult")
mult2 = input.float(1.3, title="BB Mult 2")
src = input.source(close, title="Source")

basis = ta.sma(src, length)
dev = mult * ta.stdev(src, length)
dev2 = mult2 * ta.stdev(src, length)

B1 = basis + dev
B2 = basis + dev2
B3 = basis
B4 = basis - dev2
B5 = basis - dev

// Plot outside the realtime condition for continuous visibility
// Use a single color (e.g. yellow) to easily compare and overlay with the original BB+MB
c_line = color.new(color.yellow, 0)
plot(B1, color=c_line, title="B1 (+Mult)")
plot(B2, color=c_line, title="B2 (+Mult2)")
plot(B3, color=c_line, title="B3 (Basis)")
plot(B4, color=c_line, title="B4 (-Mult2)")
plot(B5, color=c_line, title="B5 (-Mult)")

// Debug Table for visual validation
var table debugTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(debugTable, 0, 0, "Band", text_color=color.white)
    table.cell(debugTable, 1, 0, "Value", text_color=color.white)
    
    table.cell(debugTable, 0, 1, "B1", text_color=color.white)
    table.cell(debugTable, 1, 1, str.tostring(B1, "#.####"), text_color=color.white)
    
    table.cell(debugTable, 0, 2, "B2", text_color=color.white)
    table.cell(debugTable, 1, 2, str.tostring(B2, "#.####"), text_color=color.white)
    
    table.cell(debugTable, 0, 3, "B3", text_color=color.white)
    table.cell(debugTable, 1, 3, str.tostring(B3, "#.####"), text_color=color.white)
    
    table.cell(debugTable, 0, 4, "B4", text_color=color.white)
    table.cell(debugTable, 1, 4, str.tostring(B4, "#.####"), text_color=color.white)
    
    table.cell(debugTable, 0, 5, "B5", text_color=color.white)
    table.cell(debugTable, 1, 5, str.tostring(B5, "#.####"), text_color=color.white)

if barstate.isrealtime and barstate.isconfirmed
    string jsonStr = '{' +
      '"tvSymbol":"' + syminfo.tickerid + '",' +
      '"timeframe":"' + timeframe.period + '",' +
      '"barTimestamp":' + str.tostring(time) + ',' +
      '"open":' + str.tostring(open) + ',' +
      '"high":' + str.tostring(high) + ',' +
      '"low":' + str.tostring(low) + ',' +
      '"close":' + str.tostring(close) + ',' +
      '"volume":' + str.tostring(volume) + ',' +
      '"indicator":{' +
        '"length":' + str.tostring(length) + ',' +
        '"source":"close",' +
        '"mult":' + str.tostring(mult) + ',' +
        '"mult2":' + str.tostring(mult2) + 
      '},' +
      '"plots":{' +
        '"B1":' + str.tostring(B1) + ',' +    
        '"B2":' + str.tostring(B2) + ',' +      
        '"B3":' + str.tostring(B3) + ',' +      
        '"B4":' + str.tostring(B4) + ',' +    
        '"B5":' + str.tostring(B5) +
      '}' +
    '}'

    alert(jsonStr, alert.freq_once_per_bar_close)
