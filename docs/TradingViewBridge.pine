//@version=5
indicator("BB + MB Bridge (Alert Version)", overlay=true)

// =====================================================
// 1. INPUTS
// =====================================================

length = input.int(20, minval=1, title="Length")

sourceStr = input.string(
     "close",
     title="Source",
     options=["open", "high", "low", "close"]
)

mult = input.float(
     2.5,
     minval=0.001,
     maxval=50,
     title="Mult"
)

mult2 = input.float(
     1.3,
     minval=0.001,
     maxval=50,
     title="Mult2"
)

// =====================================================
// 2. SOURCE
// =====================================================

float srcSeries = switch sourceStr
    "open" => open
    "high" => high
    "low" => low
    => close

// =====================================================
// 3. BB + MB
// Công thức giữ nguyên theo contract
// =====================================================

basis = ta.sma(srcSeries, length)

stdevValue = ta.stdev(srcSeries, length)

dev = mult * stdevValue
dev2 = mult2 * stdevValue

upper = basis + dev
upper2 = basis + dev2

lower = basis - dev
lower2 = basis - dev2

// =====================================================
// 4. CANONICAL LINE MAPPING
// =====================================================
//
// Line 1 = upper
// Line 2 = upper2
// Line 3 = basis
// Line 4 = lower2
// Line 5 = lower
//

plot(upper, title="Line 1 - upper", color=color.orange)
plot(upper2, title="Line 2 - upper2", color=color.orange)

plot(basis, title="Line 3 - basis", color=color.red)

plot(lower2, title="Line 4 - lower2", color=color.orange)
plot(lower, title="Line 5 - lower", color=color.orange)

// =====================================================
// 5. REALTIME WEBHOOK
// Chỉ gửi khi realtime candle đã đóng
// =====================================================

if barstate.isrealtime and barstate.isconfirmed

    jsonStr = '{"secret":"YOUR_WEBHOOK_SECRET","tvSymbol":"' + syminfo.ticker +
      '","tvTickerId":"' + syminfo.tickerid +
      '","timeframe":"' + timeframe.period +
      '","barTimestamp":' + str.tostring(time) +
      ',"open":' + str.tostring(open) +
      ',"high":' + str.tostring(high) +
      ',"low":' + str.tostring(low) +
      ',"close":' + str.tostring(close) +
      ',"volume":' + str.tostring(volume) +
      ',"indicator":{"length":' + str.tostring(length) +
      ',"source":"' + sourceStr +
      '","mult":' + str.tostring(mult) +
      ',"mult2":' + str.tostring(mult2) +
      '},"plots":{"upper":' + str.tostring(upper) +
      ',"upper2":' + str.tostring(upper2) +
      ',"basis":' + str.tostring(basis) +
      ',"lower2":' + str.tostring(lower2) +
      ',"lower":' + str.tostring(lower) +
      '}}'

    alert(jsonStr, alert.freq_once_per_bar_close)
