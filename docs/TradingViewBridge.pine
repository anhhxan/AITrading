//@version=5
indicator("BB + MB DATA BRIDGE - Phase 3.5 Strict Final v3", overlay=true)

// =====================================================================
// 1. CẤU HÌNH BANDS & INDICATORS
// =====================================================================
length = input.int(20, title="BB Length")
mult = input.float(2.0, title="BB Mult")
mult2 = input.float(1.0, title="BB Mult 2")

basis = ta.sma(close, length)
dev = mult * ta.stdev(close, length)
dev2 = mult2 * ta.stdev(close, length)

B1 = basis + dev
B2 = basis + dev2
B3 = basis
B4 = basis - dev2
B5 = basis - dev

plot(B1, color=color.red, title="B1")
plot(B2, color=color.orange, title="B2")
plot(B3, color=color.white, title="B3 (MB)")
plot(B4, color=color.blue, title="B4")
plot(B5, color=color.green, title="B5")

// =====================================================================
// 2. STATE MACHINE (IDLE -> ARM -> FIRE/CANCEL)
// =====================================================================
varip string state = "IDLE"
varip float s_B1 = na
varip float s_B2 = na
varip float s_B3 = na
varip float s_B4 = na
varip float s_B5 = na
varip float s_Trigger = na

// =====================================================================
// 3. ĐIỀU KIỆN ARM (Chỉ đánh giá khi nến trước vừa đóng)
// =====================================================================
if barstate.isnew and state == "IDLE"
    if close[1] >= B5[1] and close[1] <= B4[1]
        state := "ARM_LONG"
        s_B1 := B1[1], s_B2 := B2[1], s_B3 := B3[1], s_B4 := B4[1], s_B5 := B5[1]
        s_Trigger := s_B4 + (s_B3 - s_B4) * 0.10
    else if close[1] >= B2[1] and close[1] <= B1[1]
        state := "ARM_SHORT"
        s_B1 := B1[1], s_B2 := B2[1], s_B3 := B3[1], s_B4 := B4[1], s_B5 := B5[1]
        s_Trigger := s_B2 - (s_B2 - s_B3) * 0.10

// =====================================================================
// 4. KIỂM TRA REALTIME INTRABAR (Đánh giá từng Tick)
// =====================================================================
bool isFireLongTick = false
bool isFireShortTick = false
varip bool labelLongThisBar = false
varip bool labelShortThisBar = false

if barstate.isnew
    labelLongThisBar := false
    labelShortThisBar := false

bool longHit    = (close <= s_Trigger)
bool shortHit   = (close >= s_Trigger)
bool longCancel = (close > s_B3)
bool shortCancel= (close < s_B3)

if state == "ARM_LONG"
    if longHit
        isFireLongTick := true
        labelLongThisBar := true
        state := "IDLE"
    else if longCancel
        state := "IDLE"

else if state == "ARM_SHORT"
    if shortHit
        isFireShortTick := true
        labelShortThisBar := true
        state := "IDLE"
    else if shortCancel
        state := "IDLE"

// =====================================================================
// 5. BẮN WEBHOOK INTRABAR
// =====================================================================
if isFireLongTick or isFireShortTick
    string direction = isFireLongTick ? "LONG" : "SHORT"
    string jsonStr = '{"secret":"6b836317269f4c43b2c4ff21004abbad",' +
                     '"direction":"' + direction + '",' +
                     '"symbol":"' + syminfo.ticker + '",' +
                     '"timeframe":"' + timeframe.period + '",' +
                     '"barTimestamp":' + str.tostring(time) + ',' +
                     '"bands":{"B1":' + str.tostring(s_B1) + 
                     ',"B2":' + str.tostring(s_B2) + 
                     ',"B3":' + str.tostring(s_B3) + 
                     ',"B4":' + str.tostring(s_B4) + 
                     ',"B5":' + str.tostring(s_B5) + '}}'
    alert(jsonStr, alert.freq_once_per_bar)

// =====================================================================
// 6. VISUAL DEBUG TRÊN CHART
// =====================================================================
bool showLongTrigger = (state == "ARM_LONG")
bool showShortTrigger = (state == "ARM_SHORT")

plot(showLongTrigger ? s_Trigger : na, color=color.green, style=plot.style_circles, linewidth=1, title="LONG Trigger")
plot(showShortTrigger ? s_Trigger : na, color=color.red, style=plot.style_circles, linewidth=1, title="SHORT Trigger")

plotshape(labelLongThisBar, title="LONG FIRED", style=shape.triangleup, location=location.belowbar, color=color.green, text="LONG", textcolor=color.white, size=size.small)
plotshape(labelShortThisBar, title="SHORT FIRED", style=shape.triangledown, location=location.abovebar, color=color.red, text="SHORT", textcolor=color.white, size=size.small)

var table debugTable = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 50), border_color=color.gray, border_width=1)
if barstate.islast
    color stateColor = color.gray
    if state == "ARM_LONG"
        stateColor := color.green
    if state == "ARM_SHORT"
        stateColor := color.red
    table.cell(debugTable, 0, 0, "STATE: " + state, text_color=color.white, bgcolor=stateColor)
